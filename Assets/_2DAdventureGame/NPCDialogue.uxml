    <ui:VisualElement name="UIDialogueBox" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/Ruby/UI/UIDialogueBox.png?fileID=21300000&amp;guid=c4592e9bd029fcc45843314f2192f59e&amp;type=3#UIDialogueBox&quot;); background-color: rgba(170, 170, 170, 0);">
        <ui:Label text="«Тисни C, щоб стріляти&#10;&#10;шестернями, і допоможи полагодити ці зламані роботи! Повертайся, коли закін-&#10;чиш»." name="Label" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 35px; padding-right: 35px; padding-bottom: 35px; padding-left: 35px; white-space: normal; height: 100%; width: 100%; -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Packages/com.unity.cinemachine/Runtime/Debug/CinemachineRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=df9aec944f4474a04847b6d6375e4138&amp;type=3#NotInter-Regular&quot;); font-size: 50%; background-size: 100% 100%; -unity-background-scale-mode: stretch-to-fill; -unity-text-align: upper-left;"/>
